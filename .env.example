# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- Model provider (pick one) ------------------------------------------------------
# Claude (default). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Or VT ARC (free, needs eduroam or the VT VPN): set ADPB_PROVIDER=vtarc
# ADPB_PROVIDER=vtarc
# VT_ARC_API_KEY=
# VT_ARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
# VT_ARC_MODEL=vt-arc-llm

# Optional per-role model overrides (defaults: Sonnet 5.5 for planner/coder/debugger,
# Haiku 5.5 for tester/validator)
# ADPB_MODEL_PLANNER=claude-sonnet-5-5
# ADPB_MODEL_CODER=claude-sonnet-5-5
# ADPB_MODEL_DEBUGGER=claude-sonnet-5-5
# ADPB_MODEL_TESTER=claude-haiku-5-5
# ADPB_MODEL_VALIDATOR=claude-haiku-5-5

# --- Where things live ----------------------------------------------------------------
# ADPB_HOME=./var                          runs, memory (ChromaDB), warehouse
# ADPB_WAREHOUSE_URL=sqlite:///./var/warehouse.db

# --- Safety -----------------------------------------------------------------------------
# HMAC secret for human-approval tokens. Generated into var/.approval_secret if unset.
# ADPB_APPROVAL_SECRET=
# Hosts that API sources may be fetched from (comma-separated)
# ADPB_API_ALLOWED_HOSTS=api.example.com
# docker (default, isolated) | local (tests only - NO isolation)
# ADPB_SANDBOX=docker

# --- Public deployment (leave unset on a laptop) --------------------------------------
# Total US dollars all visitors together may spend on builds per day. When it is used up
# the Build page stops taking new runs until the next day. Also allows one build at a time.
# ADPB_DAILY_USD=1.00
# Give every browser its own private runs, memory and warehouse, so visitors never see
# each other's runs or uploaded files.
# ADPB_PRIVATE_RUNS=1
# Memory limit for each sandbox container (default 1g). Lower it on a small server.
# ADPB_SANDBOX_MEMORY=300m
